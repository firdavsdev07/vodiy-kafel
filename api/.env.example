# ─────────────────────────────────────────────────────────────
#  Vodiy Kafel Backend — muhit o'zgaruvchilari
#  Nusxa oling:  cp .env.example .env
# ─────────────────────────────────────────────────────────────

# Umumiy
NODE_ENV=development
PORT=3000
APP_URL=http://localhost:3000

# Ma'lumotlar bazasi (local PostgreSQL)
DATABASE_URL=postgresql://postgres:PAROL@localhost:5432/vodiy-kafel?schema=public

# Autentifikatsiya
# ⚠ Kamida 32 belgi. Generatsiya: openssl rand -base64 48
JWT_SECRET=CHANGE_ME_min_32_belgi_______________________
JWT_EXPIRES=15m
JWT_REFRESH_SECRET=CHANGE_ME_boshqa_min_32_belgi________________
JWT_REFRESH_EXPIRES=30d

# Swagger hujjatlari (/api/docs)
SWAGGER_ENABLED=true

# CORS — vergul bilan ajratilgan domenlar yoki *
CORS_ORIGINS=*

# Ishonchli proksi soni (nginx ortida — 1). 0 — proksi yo'q.
# ⚠ Proksi ortida 0 qolsa, rate-limit hamma mehmonni bitta IP deb sanaydi.
TRUST_PROXY=0

# Yuklangan fayllar papkasi — /uploads/... manzili orqali beriladi
UPLOAD_DIR=uploads

# To'lov provayderi (hozircha faqat mock)
PAYMENT_PROVIDER=mock
# true — mock to'lov 10 soniyadan keyin avtomatik PAID bo'ladi
PAYMENT_MOCK_AUTO_PAID=false

# Zaxira nusxa (T-018) — bazadagi BARCHA jadvallar davriy ko'chiriladi,
# baza ishlamay qolsa ham ma'lumot topilsin. Parol xeshlari yuborilmaydi.
#   off    — o'chiq
#   file   — mahalliy CSV (BACKUP_FILE_DIR/<jadval>.csv), Google'siz sinash uchun
#   google — Google Sheets: har jadval alohida varaq, `_holat` — oxirgi yangilanish
BACKUP_PROVIDER=off
BACKUP_INTERVAL_MINUTES=15
BACKUP_FILE_DIR=backups
#
# Google Sheets'ni ulash (bir marta):
#   1. console.cloud.google.com → yangi loyiha → "Google Sheets API" ni yoqish.
#   2. IAM → Service Accounts → yaratish → Keys → "Add key" → JSON yuklab olish.
#   3. sheets.new da bo'sh jadval ochib, "Share" → service account email'i
#      (…@….iam.gserviceaccount.com) → "Editor". ⚠ Jadvalda mijozlarning
#      telefoni, INN, balansi bo'ladi — boshqa hech kim bilan ulashilmasin.
#   4. Jadval manzilidagi ID: docs.google.com/spreadsheets/d/<ID>/edit
#   5. JSON'dagi `client_email` va `private_key` ni pastga qo'ying
#      (private_key bir qatorda, qo'shtirnoq ichida, \n lari bilan).
GOOGLE_SHEETS_SPREADSHEET_ID=
GOOGLE_SERVICE_ACCOUNT_EMAIL=
GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY=
