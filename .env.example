# ─────────────────────────────────────────────────────────────
#  Vodiy Kafel Backend — muhit o'zgaruvchilari
#  Nusxa oling:  cp .env.example .env
# ─────────────────────────────────────────────────────────────

# Umumiy
NODE_ENV=development
PORT=3000
APP_URL=http://localhost:3000

# Ma'lumotlar bazasi (local PostgreSQL)
DATABASE_URL=postgresql://postgres:PAROL@localhost:5432/vodiy-kafel?schema=public

# Autentifikatsiya
# ⚠ Kamida 32 belgi. Generatsiya: openssl rand -base64 48
JWT_SECRET=CHANGE_ME_min_32_belgi_______________________
JWT_EXPIRES=15m
JWT_REFRESH_SECRET=CHANGE_ME_boshqa_min_32_belgi________________
JWT_REFRESH_EXPIRES=30d

# Swagger hujjatlari (/api/docs)
SWAGGER_ENABLED=true

# CORS — vergul bilan ajratilgan domenlar yoki *
CORS_ORIGINS=*

# Yuklangan fayllar papkasi — /uploads/... manzili orqali beriladi
UPLOAD_DIR=uploads
